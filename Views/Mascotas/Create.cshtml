@model SistemaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Nueva Mascota";
}

<h2>Registrar Mascota</h2>
<hr />

<form asp-action="Create" enctype="multipart/form-data">
    <div class="row mt-3">
        <div class="col-md-5">
            <div class="mb-3">
                <label>Nombre Mascota</label>
                <input asp-for="Nombre" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Propietario</label>
                <select asp-for="IdPropietario" asp-items="ViewBag.Propietarios" class="form-select" required>
                    <option value="">-- Selecciona --</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Especie</label>
                <select id="cbEspecie" name="IdEspecie" asp-items="ViewBag.Especies" class="form-select" required>
                    <option value="">-- Selecciona Especie --</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Raza</label>
                <select asp-for="IdRaza" id="cbRaza" class="form-select" required>
                    <option value="">-- Primero elige la especie --</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Fecha Nacimiento</label>
                <input asp-for="FechaNacimiento" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Peso (kg)</label>
                <input asp-for="Peso" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Foto de la Mascota</label>
                <input type="file" name="foto" id="foto" class="form-control" accept="image/*" required />
            </div>

            <button type="submit" class="btn btn-primary mt-2">Guardar Mascota</button>
            <a asp-action="Index" class="btn btn-secondary mt-2 ms-2">Regresar</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById("cbEspecie").addEventListener("change", function() {
            var idEspecie = this.value;
            var selectRaza = document.getElementById("cbRaza");
            
            selectRaza.innerHTML = '<option value="">Cargando...</option>';

            if(idEspecie) {
                fetch('/Mascotas/CargarRazas?idEspecie=' + idEspecie)
                .then(response => response.json())
                .then(data => {
                    selectRaza.innerHTML = '<option value="">-- Selecciona Raza --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.value;
                        opt.text = item.text;
                        selectRaza.add(opt);
                    });
                })
                .catch(err => {
                    console.error(err);
                    selectRaza.innerHTML = '<option value="">Error al cargar</option>';
                });
            } else {
                selectRaza.innerHTML = '<option value="">-- Primero elige la especie --</option>';
            }
        });
    </script>
}
